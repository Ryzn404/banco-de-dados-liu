# Copie para .env e preencha. Nunca versione o .env.
SUPABASE_PROJECT_REF=seu-project-ref
SUPABASE_URL=https://seu-project-ref.supabase.co

# Painel > Account > Access Tokens (usado só pelo scripts/setup.py)
SUPABASE_ACCESS_TOKEN=sbp_...

# Painel > Project Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Usuário administrador criado pelo setup (login "liu" no app = liu@obras.local)
APP_USER_EMAIL=liu@obras.local
APP_USER_PASSWORD=troque-esta-senha
